# Copy to .env and fill in the key(s) matching your DEFAULT_MODEL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# LiteLLM routing note: Claude/OpenAI model strings work as-is (e.g.
# claude-sonnet-5, gpt-5.1). For Gemini, use the "gemini/" prefix (e.g.
# gemini/gemini-2.5-pro) so LiteLLM routes through the Gemini API using
# GEMINI_API_KEY -- the bare model name without the prefix routes to
# Vertex AI instead, which needs GCP credentials, not this key.
DEFAULT_MODEL=claude-sonnet-5

STT_DEVICE=cpu
TTS_DEVICE=cpu
# "kokoro" (lighter, less natural on non-English), "chatterbox" (Chatterbox
# Multilingual -- more natural Italian, but slow on CPU: ~16s/sentence
# measured), or "pockettts" (Kyutai Pocket TTS -- natural Italian, built
# CPU-first for speed). See chatterbox_tts.py and pockettts_tts.py.
TTS_ENGINE=kokoro

HOST=0.0.0.0
PORT=8765

# SQLite file storing transcripts, long-term memory facts, and the
# admin-editable system prompt override (db.py). For Docker (docker-
# compose.yml's db_data volume is mounted at /app/data), use
# /app/data/haro.db so it survives a container recreate; for local
# (non-Docker) development, a bare relative path like haro.db is fine.
DB_PATH=/app/data/haro.db

# Protects the /admin web UI (system prompt editor, transcript log, memory
# browser) with HTTP Basic Auth -- any username, this password. Leave unset
# to disable the admin UI entirely (it is NOT served unprotected).
ADMIN_PASSWORD=

# Music playback from a self-hosted Navidrome server (navidrome.py). All
# three must be set, or music requests get a plain "not configured" error
# reply instead. NAVIDROME_URL is the server's base address, no trailing
# slash or /rest path (e.g. http://192.168.1.50:4533).
NAVIDROME_URL=
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
